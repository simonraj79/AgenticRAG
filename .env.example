# Copy to .env and fill in. .env is gitignored; this file is not.
# Var names below are the ones the SDKs read automatically unless noted.

# ---- OpenRouter ----------------------------------------------------------
# https://openrouter.ai/keys
# Used for: EVERY chat model — generation, the rewrite decision, the golden-set
# generator and the Ragas judge — AND, since 2026-08-16, the embeddings too.
# One key, one gateway. NOT read automatically: passed explicitly in
# app/rag/llm.py and app/rag/retriever.py.
#
# This is now the key whose absence breaks everything rather than one half.
OPENROUTER_API_KEY=

# ---- Google AI Studio ----------------------------------------------------
# https://aistudio.google.com/apikey
# Used for: EMBEDDINGS, on the ROLLBACK route only. OPTIONAL as shipped.
#
# Embeddings moved to OpenRouter on 2026-08-16, keeping the SAME model
# (gemini-embedding-2) at the SAME 768 dimensions. That was safe because another
# gateway to the same model is not another embedder — measured at cosine
# 1.000000 through both routes, on embed_documents AND embed_query, against a
# cross-string control of 0.616. No re-ingest.
#
# The underlying rule has NOT relaxed: every vector in Pinecone was written in
# this model's space, and querying that index through a genuinely different
# EMBEDDER returns confident nonsense rather than an error — matching dimensions
# do not imply a shared space. Set EMBEDDING_ROUTE=google to fall back here.
#
# Read automatically by langchain-google-genai, which checks GOOGLE_API_KEY
# first, then GEMINI_API_KEY. Either name works; keeping GEMINI_API_KEY.
GEMINI_API_KEY=

# ---- Pinecone ------------------------------------------------------------
# https://app.pinecone.io  ->  API Keys
# Read automatically by the pinecone SDK / langchain-pinecone.
PINECONE_API_KEY=

# App convention, NOT read automatically — passed to PineconeVectorStore.
# Index must be 768 dimensions, cosine, ap-southeast-1 (see PRD 6.2).
PINECONE_INDEX_NAME=agentic-rag-ntu

# NOTE: no PINECONE_ENVIRONMENT / region var needed. That is legacy pod-based
# config. Serverless indexes carry their own cloud+region, fixed at creation.

# ---- Cohere --------------------------------------------------------------
# https://dashboard.cohere.com/api-keys
# Used for: Stage 2 reranking (free tier, 1000 calls/month).
# Read automatically by langchain-cohere.
COHERE_API_KEY=

# ---- Database ------------------------------------------------------------
# Written by scripts/create_render_db.py. Local dev uses the EXTERNAL url;
# on Render, set DATABASE_URL to the INTERNAL one — private network, same
# region, far faster. External access may need your IP added to the
# database's allow-list in the Render dashboard.
DATABASE_URL=
DATABASE_URL_INTERNAL=

# ---- Google OAuth --------------------------------------------------------
# console.cloud.google.com/auth -> Clients -> Create client -> Web application
# Must be created by hand; Google exposes no API for this.
# The secret is shown exactly once at creation.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Must match the Google console entry EXACTLY — scheme, case, trailing slash.
# Pin it here rather than deriving it from request.url_for(), which returns
# the internal http:// URL behind Render's TLS-terminating proxy.
OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Signs the session cookie that carries OAuth state/nonce/PKCE verifier.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=

# CORS allowlist + post-login redirect target.
FRONTEND_URL=http://localhost:5173

# ---- Deployed service URLs (not secret) ----------------------------------
# Render appends a random suffix to service hostnames, so these cannot be
# predicted before creation. Written by scripts/create_render_services.py.
RENDER_BACKEND_URL=https://agentic-rag-api-6x6b.onrender.com
RENDER_FRONTEND_URL=https://agentic-rag-web-e9e9.onrender.com

# ---- Cloudflare R2 (object storage) ----
# https://dash.cloudflare.com/?to=/:account/r2
# Used for: handout files and original document uploads. Postgres keeps only
# structured data. See "new features/13-object-storage/PLAN.md".
#
# NOT read automatically. boto3 would happily read AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY out of the environment; these are R2_-prefixed on purpose
# so nothing is picked up by accident, and app/storage.py passes them explicitly.
# **Nothing here calls AWS.** R2 speaks the S3 protocol and boto3 is an
# S3-protocol client -- the same relationship ChatOpenAI has with OpenRouter.
#
# REQUIRED while STORAGE_ROUTE=r2 (the default), and required at LOAD: a blank
# value here makes the app refuse to start rather than fail at the first
# download, inside a background job, as a handout stuck at "failed".
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=groundwork-media

# Optional. Derived from R2_ACCOUNT_ID when blank.
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com

# Optional. "postgres" is the rollback road -- it reads bytes from
# handouts.content, which this change set deliberately did NOT drop.
# STORAGE_ROUTE=r2

# Presigned URL lifetime in seconds. The only access control that survives the
# move: a presigned URL IS the capability, so `Cache-Control: no-store` cannot be
# reproduced and expiry is what is left.
# R2_PRESIGN_TTL_S=300

# PROVISIONING ONLY -- scripts/create_r2_bucket.py, never the deployed service.
# This is the cfat_... management token that can create and delete BUCKETS, which
# is a different credential from the access-key pair above even though the access
# key id is this token's id. Same rule as RENDER_API_KEY: it must not reach Render.
# R2_API_TOKEN=

# ---- Render --------------------------------------------------------------
# https://dashboard.render.com/u/settings#api-keys
# LOCAL ONLY. Deploy/management credential — the app never reads it.
# Do NOT add this one to the deployed service's environment variables.
RENDER_API_KEY=

# ---- Model overrides (all optional; defaults in backend/app/config.py) ----
# OpenRouter slugs, so `author/model` — a bare id is a 404 that reads like an
# outage. app/rag/llm.py maps the known legacy ids and warns rather than
# guessing silently.
#
# Generation, the agent loop and handouts all read GENERATION_MODEL. Setting it
# back to google/gemma-4-31b-it is supported and changes real behaviour: Gemma
# will not initiate a corpus search on its own judgement (0 of N in every prompt
# configuration tried), so the gap trigger in app/rag/agent_loop.py stops being
# belt-and-braces and starts being the thing that makes multi-hop work.
#
# This is the SERVICE DEFAULT. Since 2026-08-16 each agent can override it from
# the settings sheet (agents.generation_model), so changing this moves only the
# agents that have not chosen for themselves.
# GENERATION_MODEL=deepseek/deepseek-v4-flash-0731
#
# Thinking, for GENERATION_MODEL only. Off by default: it was 60-79% of billed
# output tokens, and handouts produced their file first try 6/6 with it off
# against 5/6 on, at a quarter of the latency.
# DO NOT turn this off AND remove TOOL_GUIDANCE's closing paragraph. They are
# redundant with each other -- either alone holds tool use at 6/6, and losing
# both drops it to 2/6 with nothing raising. agentic_check.py S16 asserts it.
# GENERATION_REASONING=false
#
# The rewriter. Deliberately still Gemma: measured 9/9 correct at p50 1.02s
# against DeepSeek's 9/9 at 1.58s, and a regression here is invisible because
# contextualize_question swallows exceptions and degrades to Stage 1.
# DECISION_MODEL=google/gemma-4-31b-it
# RAGAS_JUDGE_MODEL=google/gemini-3.7-flash
#
# Drafts the golden set. A THIRD vendor on purpose, since 2026-08-16: while this
# equalled RAGAS_JUDGE_MODEL the judge was grading against reference answers it
# had written itself. The cost is measured and real — MiniMax writes shorter
# references (median 24 chars vs Flash's 95), which LLMContextRecall reads, and
# app/eval/generate.py's reference_answer description is the mitigation. Set it
# back to google/gemini-3.7-flash to trade independence for longer references
# and half the latency. See backend/app/config.py.
# GOLDEN_SET_MODEL=minimax/minimax-m3
#
# ---- The question rewriter -----------------------------------------------
# Since 2026-08-16 the rewriter runs on EVERY turn, not only on follow-ups, so
# it can repair typos and shorthand before the question is embedded rather
# than only resolving pronouns. false restores the old first-turn-verbatim
# behaviour exactly — it is the off-switch that makes "byte-identical to before"
# expressible, which matters because a broken rewriter degrades silently.
#
# It deliberately does NOT expand acronyms. That bullet was built, fabricated
# ("Ka-band (Kurtz-band)" in 2 of 5 trials; "LS&T" -> "Link System and
# Telemetry", which moved retrieval to the wrong file), was narrowed to a
# conditional version that measured 5/5, and was removed anyway — the value was
# the first-turn case, where nothing has spelled anything out. The prompt now
# forbids expansion outright; backend/app/rag/pipeline.py carries the record.
# REWRITE_EVERY_TURN=true
#
# Eval turns opt OUT. A golden question must reach the embedder verbatim or the
# EVAL.md baselines stop being comparable, silently. Turn this on only with a
# full re-run of the baselines.
# EVAL_REWRITE_QUESTIONS=false
#
# ---- Embeddings ----------------------------------------------------------
# Which gateway embeds. "openrouter" (default) or "google" (the rollback).
# The MODEL and the 768 dimensions are identical either way — this names the
# road, not the space, which is why EMBEDDING_MODEL below does not change with
# it and why switching needs no re-ingest.
# EMBEDDING_ROUTE=openrouter
#
# The space. Stamped onto agents.embedding_model and ingestion_runs. Changing
# THIS means deleting the index and re-ingesting. Changing the ROUTE does not.
# EMBEDDING_MODEL=models/gemini-embedding-2
# OPENROUTER_EMBEDDING_MODEL=google/gemini-embedding-2
#
# The other half of the space, and it is PART OF THE INDEX in exactly the same
# way the model is. A Pinecone index fixes its dimension at creation, so changing
# this does not degrade retrieval — it cannot be applied at all without deleting
# the index and re-ingesting every namespace from chunks.text. gemini-embedding-2
# renormalises automatically at non-default dimensions, so 768 is a real MRL
# truncation of the native 3072 and not a padded one; the cosine equality
# measured across both embedding routes was measured AT 768.
# EMBEDDING_DIMENSION=768
#
# Texts per embeddings request. A hard provider ceiling (101 inputs returns
# "at most 100 requests can be in one batch"), not a tuning knob.
# EMBEDDING_BATCH_SIZE=100
#
# Thinking cannot be disabled on Gemini 3.7 Flash (reasoning is mandatory),
# only turned down: high | medium | low.
# RAGAS_JUDGE_REASONING_EFFORT=low
#
# Route only to providers that advertise EVERY parameter in the request. Leave
# it on. Off is OpenRouter's default and it silently drops what a provider does
# not support — which for `function_calling` means `tools` vanishes and a typed
# decision comes back as prose. Turn it off only to diagnose a
# "No endpoints found that can handle the requested parameters" 404.
# OPENROUTER_REQUIRE_PARAMETERS=true
