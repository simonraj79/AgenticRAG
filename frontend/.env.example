# Frontend environment. Copy to `.env.local` for local overrides.
#
# THIS FILE TAKES EXACTLY ONE VALUE, AND THAT IS DELIBERATE.
#
# Vite inlines every `VITE_*` variable into the JavaScript bundle as a string
# literal. They are readable in devtools by anyone who loads the page, and this
# repository is public, so they are readable in git as well. A `VITE_` prefix is
# a publication instruction, not a configuration one.
#
# Every credential in this system -- Gemini, Pinecone, Cohere, the Google OAuth
# client secret, the session signing key -- stays in FastAPI's environment and
# is never sent to the browser. See PRD section 7.

# Where the FastAPI backend lives. Defaults to http://localhost:8000 when unset,
# so local development needs no .env file at all.
#
# On Render this is set on the static site to the backend's real hostname, which
# carries a random suffix and cannot be predicted before the service exists --
# `scripts/create_render_services.py --wire` reads it back and sets it.
VITE_API_URL=http://localhost:8000
