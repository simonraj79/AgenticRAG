# Better Auth service -- Google identity in, a verifiable JWT out.
#
# Copy to auth/.env for local development. On Render these are set on the
# `agentic-rag-web` service, NOT on the API service.
#
# NOTE: Render's env vars DRIFT from a local .env, and presence is not
# correctness -- this project has already shipped a production Cohere key that
# was silently the old trial one. Compare by VALUE:
#   curl -s -H "Authorization: Bearer $RENDER_API_KEY" \
#     "https://api.render.com/v1/services/<web-service-id>/env-vars?limit=100"

# ---- Database --------------------------------------------------------------
# The SAME Render Postgres the FastAPI service uses. Better Auth creates and
# owns `user`, `session`, `account`, `verification` and `jwks` here.
#
# On Render use the INTERNAL host (no dots, e.g. dpg-xxxxx-a) -- it stays on the
# private network. src/auth.ts detects that shape and relaxes certificate
# VERIFICATION, because the internal endpoint presents a self-signed cert. The
# connection is still encrypted. Locally use the EXTERNAL host, which has a
# valid public certificate and verifies normally.
DATABASE_URL=

# ---- Better Auth -----------------------------------------------------------
# The origin this service answers on, which is ALSO the origin serving the SPA.
# They are the same string on purpose: co-locating them is what makes the
# session cookie first-party. Setting this to a separate auth host reproduces
# the third-party-cookie login bounce (CLAUDE.md, Google OAuth).
#
#   local        http://localhost:5173     (Vite proxies /api/auth to this process)
#   production   https://agentic-rag-web-e9e9.onrender.com
BETTER_AUTH_URL=http://localhost:5173

# 32+ chars. Generate with:  openssl rand -base64 32
#
# This signs session cookies AND is the root of the JWT signing keys, so
# rotating it invalidates every live session and every unexpired token at once.
# It is NOT the same value as SESSION_SECRET_KEY in the backend .env, and the
# two must not be made equal for tidiness -- they secure different systems with
# different lifetimes.
BETTER_AUTH_SECRET=

# ---- Google OAuth ----------------------------------------------------------
# The SAME client id and secret the backend .env already holds. One Google
# console client, two consumers, for as long as both auth paths are live.
#
# A NEW authorised redirect URI must be added to the console by hand -- Google
# exposes no API for this, and matching is EXACT down to scheme and trailing
# slash:
#
#   local        http://localhost:5173/api/auth/callback/google
#   production   https://agentic-rag-web-e9e9.onrender.com/api/auth/callback/google
#
# Note the shape is /api/auth/callback/{provider}, which is Better Auth's, and
# is NOT the existing /api/auth/google/callback the Authlib flow uses. Both
# entries coexist; the old one is removed only when Authlib is.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---- Runtime ---------------------------------------------------------------
# Set to `production` on Render. It is the only signal this process has for
# whether TLS is terminated in front of it, and it is what turns on secure
# cookies -- leave it unset locally or http://localhost sign-in breaks.
NODE_ENV=development

# Render injects PORT. Do not set it there. Locally it defaults to 3000.
# PORT=3000
