# ---- Secrets: never commit these ----
.env
.env.*
!.env.example
*.pem
*.key
secrets.toml
.streamlit/secrets.toml

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.Python

# Virtual environments
.venv/
venv/
env/
ENV/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# ---- Course material ----
# The NTU workshop PDFs (~17MB) are excluded pending a decision on whether
# redistributing them in a PUBLIC repo is permitted. See PRD.md open item 6.
# Large binaries in git are effectively permanent - removing them later means
# rewriting history. Delete these lines once the licensing question is settled.
*.pdf

# ---- Local working notes ----
# CLAUDE.md is kept out of the public repo by request. Two things this does NOT do:
# it does not remove the file (it stays on disk and is still the agent's brief),
# and it does not remove it from HISTORY - every version committed before this
# line is still readable on GitHub. Scrubbing those needs a history rewrite.
# EVAL.md, HANDOFF.md, PRD.md and README.md all link to it; those links resolve
# locally and 404 on GitHub. Re-track with `git add -f CLAUDE.md`.
CLAUDE.md

# ---- Node / frontend ----
node_modules/
dist/
dist-ssr/
.vite/
*.tsbuildinfo
*.local
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---- RAG runtime artifacts ----
# Chroma's embedded store is a SQLite file that gets rebuilt on ingest.
chroma_db/
.chroma/
*.sqlite3

# Documents uploaded at runtime (may be private; re-ingestable anyway)
data/uploads/

# Trace + evaluation output
traces/
eval_results/
*.trace.jsonl

# Playwright MCP session artifacts: page snapshots, console logs, screenshots.
# Written into the repo root by the browser tooling, none of it is source.
.playwright-mcp/

# ---- Editors / OS ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# The Better Auth service. `public/` is the SPA's build output copied in at
# deploy time -- a build artefact of a DIFFERENT package, so committing it would
# mean two sources of truth for the same bytes.
auth/node_modules/
auth/dist/
auth/public/
auth/.env

# Skill packs installed by `npx skills add`. The real files live in
# .agents/skills/ and ARE tracked. This directory holds ABSOLUTE symlinks into
# one developer's checkout, so committing it would break every other clone.
.claude/skills/
